# Copy to .env and fill in real values. Never commit .env.
# See docs/IMPLEMENTATION_SPEC.md §18 for what each variable is for.

# --- BigQuery / dbt (warehouse ELT path) ---
GCP_PROJECT_ID=
BQ_RAW_DATASET=medicare_raw
BQ_STAGING_DATASET=medicare_staging
BQ_MARTS_DATASET=medicare_marts
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# --- Databricks / Unity Catalog (lakehouse path) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
UNITY_CATALOG_NAME=medicare

# --- Streamlit ---
# "bigquery" or "duckdb" — use duckdb for zero-cost local iteration against
# data/samples/beneficiary_summary_sample.csv
STREAMLIT_BACKEND=duckdb

# --- Airflow (local Docker Compose) ---
AIRFLOW_UID=50000
